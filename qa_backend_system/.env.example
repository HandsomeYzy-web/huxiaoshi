# =============================================================================
# .env.example —— 环境变量模板
# 复制为 .env 后填入真实值；切勿将含真实密钥的 .env 提交到版本库。
# 仅列出结构与示例值，所有密钥请替换为你自己的。
# =============================================================================

# ==========================================
# FastAPI / 应用基础
# ==========================================
PROJECT_NAME="QA Backend System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ==========================================
# 跨域 CORS（前端访问来源白名单）
# ==========================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==========================================
# MySQL（业务主库）
# ==========================================
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3307"
MYSQL_DB="qa_system"

# ==========================================
# Redis（缓存 / 会话）
# ==========================================
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"   # 无密码可留空 ""
REDIS_DB=0

# ==========================================
# MinIO（对象存储，存放源文件）
# ==========================================
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_SECURE=False
MINIO_BUCKET_NAME="qa-knowledge-files"

# ==========================================
# Elasticsearch（向量 + 分段检索）
# ==========================================
ES_HOST="127.0.0.1"
ES_PORT="9200"
ES_SCHEME="http"
ES_VECTOR_DIM=1024
# 认证：docker-compose 默认已开启 ES 安全认证。
# ES_PASSWORD 会被 docker-compose 注入为 elastic 用户初始密码，应用与 Kibana 共用。
# 二选一：用户名+密码，或 API Key（设了 API Key 则忽略用户名密码）。
ES_USERNAME="elastic"
ES_PASSWORD="your-elasticsearch-password"
ES_API_KEY=""

# ==========================================
# 统一认证平台接入
# 应用自身不做鉴权，当前用户由上游网关通过请求头注入；
# 本地无该请求头时回退到 DEFAULT_USER_ID。
# ==========================================
CURRENT_USER_HEADER="X-User-Id"
DEFAULT_USER_ID=1

# ==========================================
# 加密（Text2SQL 数据库连接密码等敏感字段加密存储）
# APP_SECRET_KEY：任意高熵随机串
#   生成：python -c "import secrets; print(secrets.token_hex(32))"
# FERNET_KEY：合法的 Fernet 密钥（44 位 base64）
#   生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==========================================
APP_SECRET_KEY="your-app-secret-key"
FERNET_KEY="your-fernet-key"

# ==========================================
# 文件上传
# 仅支持核心文档格式：pdf/docx/xlsx/csv/pptx/txt/md
# ==========================================
MAX_UPLOAD_FILE_SIZE_MB=200

# ==========================================
# 通用检索 / LLM
# ==========================================
DEFAULT_RETRIEVAL_TOP_K=5
LLM_TIMEOUT=120

# ==========================================
# Text2SQL —— 基础开关
# ==========================================
TEXT2SQL_ENABLED=True
TEXT2SQL_MAX_ROWS=50
TEXT2SQL_READONLY=True
TEXT2SQL_EXEC_TIMEOUT_SECONDS=20
TEXT2SQL_AUTO_REPAIR_ROUNDS=2
TEXT2SQL_MULTI_TABLE_ENABLED=True
TEXT2SQL_MAX_JOIN_TABLES=5
TEXT2SQL_QUERY_LOG_ENABLED=True

# ── Self-consistency：>1 时生成多个候选 SQL 并按执行结果投票，多数胜出（1=关闭）
TEXT2SQL_SELF_CONSISTENCY_N=1
TEXT2SQL_SELF_CONSISTENCY_TEMPERATURE=0.4

# ── few-shot 示例（默认关闭）
# 用户评分(1-5星) >= 该阈值的查询才会进入示例池（5=仅“非常满意”）
TEXT2SQL_FEW_SHOT_ENABLED=False
TEXT2SQL_FEWSHOT_MIN_SCORE=5

# ── 枚举值提示（采样列的高频值注入提示词，默认关闭）
TEXT2SQL_ENUM_HINT_ENABLED=False
TEXT2SQL_ENUM_HINT_SAMPLE_ROWS=100
TEXT2SQL_ENUM_HINT_TOP_VALUES=5
TEXT2SQL_ENUM_HINT_MAX_COLUMNS_PER_TABLE=6
TEXT2SQL_ENUM_HINT_MAX_WORKERS=4
TEXT2SQL_ENUM_HINT_PROBE_TIMEOUT_MS=300
TEXT2SQL_ENUM_HINT_MAX_PROMPT_CHARS=2400
TEXT2SQL_ENUM_HINT_MAX_TABLES=3

# ── Schema 剪枝：宽表(>MAX_COLS 列)只保留与问题最相关的前 KEEP_COLS 列（默认关闭）
TEXT2SQL_SCHEMA_PRUNE_ENABLED=False
TEXT2SQL_SCHEMA_MAX_COLS_PER_TABLE=40
TEXT2SQL_SCHEMA_PRUNE_KEEP_COLS=25

# ── 表路由（候选表召回与打分；KB_ID=0 表示未配置对应知识库）
TABLE_ROUTE_KB_ID=0
TEXT2SQL_FEWSHOT_KB_ID=0
# ── 知识库隔离：表路由仅查 table_desc 库、few-shot 仅查 few-shot 库，文档问答自动排除这两个库
# KB_ID=0 时按名称解析（忽略大小写，- 与 _ 等价）；置空名称即关闭按名称解析
TEXT2SQL_TABLE_DESC_KB_NAME=table_desc
TEXT2SQL_FEWSHOT_KB_NAME=few-shot
TABLE_ROUTE_KB_SEARCH_TOP_K=120
TABLE_ROUTE_KB_RECALL_CANDIDATES=60
TABLE_ROUTE_MAX_CANDIDATES=10
TABLE_ROUTE_SEMANTIC_SCORE_WEIGHT=10.0
TABLE_ROUTE_KEYWORD_SCORE_WEIGHT=1.0
TABLE_ROUTE_PROFILE_SCORE_WEIGHT=2.0
TABLE_ROUTE_NAME_EXACT_MATCH_SCORE=2.0
TABLE_ROUTE_NAME_TOKEN_MATCH_SCORE=0.85
TABLE_ROUTE_PROFILE_TOKEN_MATCH_SCORE=0.18
TABLE_ROUTE_PROFILE_SCORE_CAP=3.0

# ==========================================
# 运行时（开发用，main.py 读取）
# ==========================================
UVICORN_RELOAD=false
